{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["standard"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "space-before-function-paren": ["error", "always"],
    "quotes": ["error", "double"],
    "comma-dangle": 0,
    "semi": 0,
    "multiline-ternary": 0,
    "no-unused-vars": 0
  }
}
