---
// import Features3 from '~/components/widgets/Features3.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: 'https://images.unsplash.com/photo-1552833287-c19070e00073?q=80&w=1995&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Image',
    }}
  >
    <Fragment slot="title"
      ><span class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading">The Story</span>
    </Fragment>

    <Fragment slot="subtitle">
      What happens when you stop trying to be the best and just start doing? Between the code, the camera, and the
      strings of a guitar or bass, I’m just a guy who loves the process of being "regular" at a lot of things.
    </Fragment>
  </Hero>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Beyond the Screen"
    subtitle="When I’m AFK, I like to switch gears and try something different. I’m usually learning something new, picking up a new interest, or exploring a sport. I just enjoy staying curious and seeing how things work."
    image={{
      src: 'https://images.unsplash.com/photo-1552833287-c19070e00073?q=80&w=1995&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Image',
    }}
    isReversed={true}
    callToAction={{
      text: 'See more',
      href: '/',
    }}
    items={[
      {
        title: 'Film & Photography',
        description:
          'I’ve always been drawn to how a single frame can set a mood. I’m a huge fan of Stanley Kubrick’s obsession with symmetry and Zack Snyder’s bold visual signature. Whether I’m behind a camera or just watching a movie, I’m usually studying the light, the framing and the color grading.',
        icon: 'tabler:globe',
      },
      {
        title: 'Music',
        description:
          'I’m primarily a Guitarist, though I spend a fair amount of time on the Bass and Piano as well. My taste is a bit of a contradiction: I live for the energy of Technical Metal, but I find a different kind of peace in Classical music.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Streaming',
        description:
          'Every now and then, I jump on stream to hang out. You’ll usually find me deep in a strategy game, mostly map-staring and overthinking my next move, or occasionally streaming my workflow while I listen to music.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Personal Stack"
    subtitle="The non-technical side"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Educational',
        description:
          'Morbi faucibus luctus quam, sit amet aliquet felis tempor id. Cras augue massa, ornare quis dignissim a, molestie vel nulla.',
        icon: 'tabler:template',
      },
      {
        title: 'Interior Design',
        description:
          'Vivamus porttitor, tortor convallis aliquam pretium, turpis enim consectetur elit, vitae egestas purus erat ac nunc nulla.',
        icon: 'tabler:template',
      },
      {
        title: 'Photography',
        description:
          'Duis sed lectus in nisl vehicula porttitor eget quis odio. Aliquam erat volutpat. Nulla eleifend nulla id sem fermentum.',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'E-commerce',
        description:
          'Rutrum non odio at vehicula. Proin ipsum justo, dignissim in vehicula sit amet, dignissim id quam. Sed ac tincidunt sapien.',
        icon: 'tabler:template',
      },
      {
        title: 'Blog',
        description:
          'Nullam efficitur volutpat sem sed fringilla. Suspendisse et enim eu orci volutpat laoreet ac vitae libero.',
        icon: 'tabler:template',
      },
      {
        title: 'Business',
        description:
          'Morbi et elit finibus, facilisis justo ut, pharetra ipsum. Donec efficitur, ipsum quis congue luctus, mauris magna.',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />
</Layout>
