      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title"
      ><span class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading">The Story</span>
    </Fragment>

    <Fragment slot="subtitle">
      What happens when you stop trying to be the best and just start doing? Between the code, the camera, and the
      strings of a guitar or bass, I’m just a guy who loves the process of being "regular" at a lot of things.
    </Fragment>
  </Hero>

