      //   I highly recommend Youssef for any web or mobile development project.`,
      //   name: 'Mohamed Adnane ABOUCHADI',
      //   job: 'Full Stack Developer at Capgemini',
      //   image: {
      //     src: 'https://media.licdn.com/dms/image/v2/D4E03AQGgeqrh-cHU-w/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1719832396342?e=1735171200&v=beta&t=-WGewrP2D2dIkZfapj_0peQ9FVtmaMG7RS84BkUphUs',
      //     alt: 'Mohamed Adnane ABOUCHADI Image',
      //   },
      // },
    ]}
    callToAction={{
      target: '_blank',
      text: 'More testimonials...',
      href: 'https://www.linkedin.com/in/jounaidyoussef/details/recommendations/',
      icon: 'tabler:chevron-right',
    }}
