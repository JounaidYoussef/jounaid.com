  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Explore my insightful articles on my blog"
    information={`Dive into a realm of design wisdom and creative inspiration, where you'll find invaluable insights, practical tips, and captivating narratives that elevate and enrich your creative journey.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-200 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Words from collaborators"
    testimonials={[
      {
        testimonial: `I had the chance to mentor Youssouf during his internship and first year at Obytes. 
        
        He showed consistent growth as a developer and a solid grasp of front-end development concepts. 
        
        Through dedicated practice and a willingness to learn, he steadily improved his skills and contributed well to our projects.`,
        name: 'Youssouf EL AZIZI',
        job: 'Mobile tribe lead at Obytes',
        image: {
          src: 'https://lh3.googleusercontent.com/d/1iXbyvDFV9iyI6UVnHGykCz1j63t9OfNj',
          alt: 'Emily Kennedy Image',
        },
      },
      {
        testimonial: `Very pleased to have been able to work with Youssef.

        When I was at Alten, I recruited him to work for one of our clients in the insurance field as a full-stack Java/Angular developer.
        Given a complex business context, he was able to integrate well and meet expectations!

        A very serious and dedicated person in his work.`,
        name: 'Thomas CHAIX',
        job: 'Engineering Manager at ALTEN',
        image: {
          src: 'https://lh3.googleusercontent.com/d/1paIX8kqTkZYKuHN7Vhfk1r3DAslTzNbo',
          alt: 'Thomas CHAIX Image',
        },
      },
      {
        testimonial: `I greatly enjoyed working with Youssef, not only for his ability to quickly grasp the topics assigned to him, but also for his friendliness and positive attitude every day.

