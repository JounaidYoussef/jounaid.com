---
import { getCollection } from 'astro:content';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Projects',
};

// Fetch all entries from the 'projects' folder in src/content/
const allProjects = await getCollection('project');

const sortedProjects = allProjects.sort((a, b) => a.data.weight - b.data.weight);
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"
      ><span class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading">The Projects</span>
    </Fragment>

    <Fragment slot="subtitle">
      A collection of things I’ve built, from side experiments to professional work. Each one represents a problem
      solved or a new tool mastered along the way.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  {
    sortedProjects.map((project, index) => (
      <Content
        isReversed={index % 2 !== 0}
        items={[
          {
            title: 'Description:',
            description: project.data.description,
          },
          {
            title: 'Role:',
            description: project.data.role,
          },
        ]}
        image={{
          src: project.data.image,
          alt: 'Tech Design Image',
          //   src: project.data.image,
          // alt: project.data.title,
        }}
        callToAction={{
          target: '_blank',
          text: 'Go to the project',
          icon: 'tabler:chevron-right',
          href: `/projects/${project.slug}`,
        }}
      >
        <Fragment slot="content">
          <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
            {project.data.title}: <br />
            <span class="text-xl font-normal text-muted">{project.data.category}</span>
          </h3>
        </Fragment>

        <Fragment slot="bg">
          <div class="absolute inset-0 bg-blue-50 dark:bg-transparent" />
        </Fragment>
      </Content>
    ))
  }
</Layout>
