---
import Layout from '~/layouts/PageLayout.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"
      ><span class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading">The Reach Out</span>
    </Fragment>

    <Fragment slot="subtitle">
      Want to build something together, or just talk about code, design, movies, or music? I’m always open to new ideas
      and fresh perspectives. Drop a message and let’s see where it goes.
    </Fragment>
  </Hero>
  <ContactUs
    id="form"
    classes={{ container: 'pt-0 lg:pt-0 md:pt-0' }}
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    description="Looking forward to replying to you soon."
  />
</Layout>
