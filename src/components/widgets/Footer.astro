---
import { Icon } from 'astro-icon/components';
import Clock from './Clock.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <!-- <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300"> -->
  <!-- // -->
  <!-- <div class="grid grid-cols-3 max-lg:flex max-lg:flex-col-reverse"> -->
  <!-- <div
        class="flex flex-col text-slate-700 dark:text-gray-300 font-extrabold items-start justify-center text-xl mb-2 max-lg:items-center max-lg:my-12"
      >
        <span class="text-sm font-light">Feel free to email me at:</span>
        <a href="mailto:youssef@jounaid.com">youssef@jounaid.com</a>
        <hr class="h-px bg-gray-200 border-0 dark:bg-gray-700" />
      </div> -->
  <div class="flex justify-center">
    <div class="flex flex-col max-w-xl items-center self-center justify-center mt-6">
      <p class="text-center text-muted pt-4 px-8">
        I’m always open to interesting offers, fresh suggestions, or just a casual chat about tech and design. If you
        have something on your mind, don't hesitate to reach out.
      </p>
      <a class="dark:text-gray-300 text-md font-bold mb-2 border-2 rounded-full px-6 py-2 my-4" href="/contact"
        >Get In Touch</a
      >
    </div>
  </div>

  <!-- <div
        class="flex flex-row items-center justify-end text-slate-700 dark:text-gray-300 font-medium mb-2 max-lg:justify-center max-lg:mr-10"
      >
        <Clock />
        <span class="flex flex-col">
          <a href="tel:33610289955" class="font-bold">(+33) 610 289 955</a>
          <hr class="h-px bg-gray-200 border-0 dark:bg-gray-700" />
          <span class="font-light text-xs">Paris, Amsterdam, Berlin (CEST)</span>
        </span>
      </div> -->
  <!-- -- -->
  <div class="flex items-center justify-center pt-6 md:pt-8">
    {
      socialLinks?.length ? (
        <ul class="flex mb-4">
          {socialLinks.map(({ ariaLabel, href, text, icon }) => (
            <li>
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label={ariaLabel}
                href={href}
              >
                {icon && <Icon name={icon} class="w-5 h-5" />}
                <Fragment set:html={text} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        ''
      )
    }
  </div>
  <div class="text-sm text-slate-700 dark:text-gray-300 flex justify-center pb-6">
    <Fragment set:html={footNote} />
  </div>
</footer>
